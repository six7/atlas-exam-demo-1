# =====================================================================
# Shared prototype registry — Supabase
#
# Copy to .env.local and fill in from:
#   Supabase → Project Settings → API Keys
#
# Supabase replaced the legacy JWT keys (`anon` / `service_role`) with
# publishable and secret keys. Legacy keys keep working until they are
# deprecated at the end of 2026. Both are accepted here — prefer the new
# ones on a new project.
#
# The app runs fine with all of these blank: the hub falls back to
# reading src/prototypes/registry.json so the repo works standalone.
# =====================================================================

# Project URL. Safe to expose — shipped in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key, `sb_publishable_…`.
# Safe to expose — it resolves to the `anon` Postgres role, and RLS is what
# protects the data: anon may SELECT prototypes and SELECT/INSERT feedback,
# nothing more.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------
# Secret key, `sb_secret_…`. SECRET — resolves to `service_role` and
# bypasses RLS entirely.
#
# Belongs in .env.local (local CI dry-runs) and GitHub Actions secrets.
# Do NOT add it to Vercel: no runtime path needs it, and leaving it out
# means a page physically cannot write to the prototypes table.
# ---------------------------------------------------------------------
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------
# Legacy fallbacks — only needed if your project still uses the old JWT
# keys. Leave blank when using the new keys above.
# ---------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
